# Local development secrets. Copy to `.env` and fill in.
# `.env` is gitignored — never commit real values.

# football-data.org API token (free tier).
# Powers matches, fixtures and the Premier League table.
# Get one at: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# Lovable AI gateway key (ai.gateway.lovable.dev).
# Powers Macedonian news translation, /chat, and "Прочитај повеќе".
# Found in the Lovable project's backend secrets.
# Leave blank to work without AI: matches/table/schedule still render,
# news falls back to untranslated English titles, /chat returns an error.
LOVABLE_API_KEY=
